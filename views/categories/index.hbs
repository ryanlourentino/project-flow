<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
  <div>
    <div class="eyebrow">Marketplace</div>
    <h1 class="mb-1">Categories</h1>
    <p class="text-muted mb-0">Browse construction materials and equipment, then compare sellers' offers.</p>
  </div>
  {{#if isAdmin}}<a href="/categories/manage" class="btn btn-outline-dark">Manage categories</a>{{/if}}
</div>

<div class="search-box mb-4">
  {{> search-icon}}
  <input id="category-search" type="search" name="q" value="{{q}}" maxlength="100" class="form-control form-control-lg"
         placeholder="Search categories or products, e.g. cement, pipe, plywood..."
         hx-get="/categories/search" hx-trigger="input changed delay:300ms, search"
         hx-target="#category-cards" hx-swap="outerHTML">
</div>

{{> category-cards}}
