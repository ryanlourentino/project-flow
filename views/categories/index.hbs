<h1 class="h3 mb-1">Categories</h1>
<p class="text-muted">Groups used to organize the catalog of materials and equipment.</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th class="text-end">Items</th>
        </tr>
    </thead>
    <tbody>
        {{#each categories}}
        <tr>
            <td>{{category_name}}</td>
            <td class="text-end">{{item_count}}</td>
        </tr>
        {{/each}}
    </tbody>
</table>