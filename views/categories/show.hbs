<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/categories">Categories</a></li>
    <li class="breadcrumb-item active" aria-current="page">{{category.category_name}}</li>
  </ol>
</nav>

<div class="eyebrow">Category</div>
<h1 class="mb-1">{{category.category_name}}</h1>
{{#if category.description}}<p class="text-muted">{{category.description}}</p>{{/if}}

<div class="search-box my-3">
  {{> search-icon}}
  <input id="item-search" type="search" name="q" value="{{q}}" maxlength="100" class="form-control"
         placeholder="Search products in {{category.category_name}}..."
         hx-get="/categories/{{category.category_id}}/items" hx-trigger="input changed delay:300ms, search"
         hx-target="#category-items" hx-swap="outerHTML">
</div>

{{> category-items}}
