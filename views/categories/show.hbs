<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/categories">Categories</a></li>
        <li class="breadcrumb-item active" aria-current="page">{{category.category_name}}</li>
    </ol>
</nav>

<h1 class="h3 mb-1">{{category.category_name}}</h1>
{{#if category.description}}<p class="text-muted">{{category.description}}</p>{{/if}}

{{#if items.length}}
<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Item</th>
            <th>Type</th>
            <th>Unit</th>
            <th class="text-end">Avg. market price</th>
        </tr>
    </thead>
    <tbody>
        {{#each items}}
        <tr>
            <td>{{item_name}}</td>
            <td>{{#if is_rentable}}<span class="badge text-bg-info">Rentable</span>{{else}}<span
                    class="badge text-bg-secondary">Material</span>{{/if}}</td>
            <td>{{unit}}</td>
            <td class="text-end">{{avg_price}}</td>
        </tr>
        {{/each}}
    </tbody>
</table>
{{else}}
<p class="text-muted">No items in this category yet.</p>
{{/if}}