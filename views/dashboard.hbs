<div class="eyebrow">Dashboard</div>
<h1 class="mb-1">Welcome, {{user.company_name}}</h1>
<p class="text-muted mb-4">
  <span class="badge rounded-pill text-bg-light border fw-normal">{{user.account_type}}</span>
  Logged in as {{user.username}}
</p>

{{#if isRejected}}
<div class="alert alert-secondary" role="status">
  <strong>Your account was rejected by the Admin.</strong> Your products are hidden from buyers. See My Products for the reason.
</div>
{{/if}}

{{!-- Tiles: a few numbers for this account type. A tile with a link opens that page (stretched-link makes
      the whole card clickable). --}}
<div class="row g-3 mb-3">
  {{#each tiles}}
  <div class="col-md-4">
    <div class="card stat-tile h-100{{#if link}} stat-tile-link{{/if}}">
      <div class="card-body">
        <div class="eyebrow mb-1">{{label}}</div>
        {{#if text}}
        <div class="stat-value">{{text}}</div>
        {{else}}
        <div><span class="stat-value">{{value}}</span> <span class="text-muted">{{unit}}</span></div>
        {{/if}}
        <div class="small text-muted text-truncate" title="{{note}}">{{note}}</div>
        {{#if link}}<a href="{{link}}" class="stretched-link" aria-label="Open {{label}}"></a>{{/if}}
      </div>
    </div>
  </div>
  {{/each}}
</div>

<div class="d-flex flex-wrap gap-2 mb-4">
  {{#each quickLinks}}
  <a href="{{href}}" class="btn {{#if primary}}btn-dark{{else}}btn-outline-dark{{/if}}">{{label}}</a>
  {{/each}}
</div>

<div class="row g-4">
  <div class="col-lg-5">
    <div class="card shadow-sm h-100">
      <div class="card-header bg-white fw-semibold">Your account</div>
      <div class="card-body">
        <dl class="row mb-0 small">
          <dt class="col-4 text-muted fw-normal">Company</dt><dd class="col-8">{{user.company_name}}</dd>
          <dt class="col-4 text-muted fw-normal">Username</dt><dd class="col-8 text-break">{{user.username}}</dd>
          <dt class="col-4 text-muted fw-normal">Account type</dt><dd class="col-8">{{user.account_type}}</dd>
          <dt class="col-4 text-muted fw-normal">Email</dt><dd class="col-8 text-break">{{user.email}}</dd>
          <dt class="col-4 text-muted fw-normal">Phone</dt><dd class="col-8">{{#if user.phone}}{{user.phone}}{{else}}-{{/if}}</dd>
          <dt class="col-4 text-muted fw-normal">Address</dt><dd class="col-8 mb-0">{{#if user.address}}{{user.address}}{{else}}-{{/if}}</dd>
        </dl>
      </div>
    </div>
  </div>
  {{#if showNotifications}}
  <div class="col-lg-7">
    {{> dashboard-notifications}}
  </div>
  {{/if}}
</div>

{{#if recentOrders.length}}
<h2 class="h5 mt-4">Recent purchases</h2>
<div class="card shadow-sm">
  <div class="table-responsive">
    <table class="table align-middle mb-0">
      <thead class="table-light">
        <tr class="small text-uppercase text-nowrap">
          <th class="ps-3">Date</th>
          <th>Product</th>
          <th class="text-end">Quantity</th>
          <th class="text-end">Total</th>
          <th class="pe-3">Status</th>
        </tr>
      </thead>
      <tbody>
        {{#each recentOrders}}
        <tr>
          <td class="ps-3 text-nowrap">{{date order_date}}</td>
          <td><a href="/items/{{item_id}}">{{item_name}}</a></td>
          <td class="text-end text-nowrap">{{quantity}} <span class="small text-muted">{{unit}}</span></td>
          <td class="text-end fw-semibold">{{money total_value}}</td>
          <td class="pe-3"><span class="badge rounded-pill text-bg-light border fw-normal">{{order_status}}</span></td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
<p class="small text-muted mt-2">Purchases from the source data. Ordering from the cart comes in Assignment #5.</p>
{{/if}}
