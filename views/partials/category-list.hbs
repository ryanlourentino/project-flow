<div id="category-list">
    {{#if error}}<div class="alert alert-danger" role="alert">{{error}}</div>{{/if}}
    {{#if message}}<div class="alert alert-success" role="status">{{message}}</div>{{/if}}

    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th class="text-end">Items</th>
                {{#if isAdmin}}<th class="text-end">Actions</th>{{/if}}
            </tr>
        </thead>
        <tbody>
            {{#each categories}}
            {{#if editing}}
            <tr>
                <td>
                    <form id="edit-form" hx-put="/categories/{{category_id}}" hx-target="#category-list"
                        hx-swap="outerHTML">
                        <input type="text" name="name" value="{{editValue}}" maxlength="{{../nameMax}}" required
                            autofocus class="form-control form-control-sm">
                    </form>
                </td>
                <td>
                    <input type="text" name="description" form="edit-form" value="{{editDescription}}"
                        maxlength="{{../descMax}}" placeholder="Description (optional)"
                        class="form-control form-control-sm">
                </td>
                <td class="text-end">{{item_count}}</td>
                <td class="text-end">
                    <button type="submit" form="edit-form" class="btn btn-sm btn-primary">Save</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" hx-get="/categories/list"
                        hx-target="#category-list" hx-swap="outerHTML">Cancel</button>
                </td>
            </tr>
            {{else}}
            <tr>
                <td><a href="/categories/{{category_id}}">{{category_name}}</a></td>
                <td>{{#if description}}{{description}}{{else}}<span class="text-muted">-</span>{{/if}}</td>
                <td class="text-end">{{item_count}}</td>
                {{#if @root.isAdmin}}
                <td class="text-end">
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                        hx-get="/categories/{{category_id}}/edit" hx-target="#category-list"
                        hx-swap="outerHTML">Edit</button>
                    <button type="button" class="btn btn-sm btn-outline-danger" hx-delete="/categories/{{category_id}}"
                        hx-target="#category-list" hx-swap="outerHTML" hx-confirm="Delete category {{category_name}}?"
                        {{#unless canDelete}}disabled title="This category still has items" {{/unless}}>Delete</button>
                </td>
                {{/if}}
            </tr>
            {{/if}}
            {{/each}}
        </tbody>
    </table>

    {{#if isAdmin}}
    <form class="row g-2" hx-post="/categories" hx-target="#category-list" hx-swap="outerHTML">
        <div class="col-md-3">
            <input type="text" name="name" value="{{newName}}" maxlength="{{nameMax}}" required
                placeholder="New category name" class="form-control">
        </div>
        <div class="col-md">
            <input type="text" name="description" value="{{newDescription}}" maxlength="{{descMax}}"
                placeholder="Description (optional)" class="form-control">
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Add category</button>
        </div>
    </form>
    {{/if}}
</div>