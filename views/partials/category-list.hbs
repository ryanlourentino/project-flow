<div id="category-list">
    {{#if error}}<div class="alert alert-danger" role="alert">{{error}}</div>{{/if}}
    {{#if message}}<div class="alert alert-success" role="status">{{message}}</div>{{/if}}

    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th class="text-end">Items</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            {{#each categories}}
            {{#if editing}}
            <tr>
                <td>
                    <form id="edit-form" hx-put="/categories/{{category_id}}" hx-target="#category-list"
                        hx-swap="outerHTML">
                        <input type="text" name="name" value="{{editValue}}" maxlength="{{../nameMax}}" required
                            autofocus class="form-control form-control-sm">
                    </form>
                </td>
                <td class="text-end">{{item_count}}</td>
                <td class="text-end">
                    <button type="submit" form="edit-form" class="btn btn-sm btn-primary">Save</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" hx-get="/categories/list"
                        hx-target="#category-list" hx-swap="outerHTML">Cancel</button>
                </td>
            </tr>
            {{else}}
            <tr>
                <td>{{category_name}}</td>
                <td class="text-end">{{item_count}}</td>
                <td class="text-end">
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                        hx-get="/categories/{{category_id}}/edit" hx-target="#category-list"
                        hx-swap="outerHTML">Edit</button>
                </td>
            </tr>
            {{/if}}
            {{/each}}
        </tbody>
    </table>

    <form class="row g-2" hx-post="/categories" hx-target="#category-list" hx-swap="outerHTML">
        <div class="col-auto flex-grow-1">
            <input type="text" name="name" value="{{newName}}" maxlength="{{nameMax}}" required
                placeholder="New category name" class="form-control">
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Add category</button>
        </div>
    </form>
</div>