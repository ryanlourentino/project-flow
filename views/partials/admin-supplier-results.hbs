<div id="supplier-results">
  {{#if error}}<div class="alert alert-danger" role="alert">{{error}}</div>{{/if}}
  {{#if message}}<div class="alert alert-success" role="status">{{message}}</div>{{/if}}

  {{!-- Filter buttons, with how many Suppliers each one has (for the current search). --}}
  <div class="d-flex flex-wrap gap-2 mb-3" hx-target="#supplier-results" hx-swap="outerHTML" hx-include="#supplier-search">
    {{#each filters}}
    <button type="button" class="btn btn-sm {{#if active}}btn-dark{{else}}btn-outline-dark{{/if}}"
            hx-get="/admin/suppliers/results" hx-vals='{"filter": "{{key}}"}'>{{label}} ({{count}})</button>
    {{/each}}
  </div>
  {{!-- The current filter and page, sent along with search, Approve and Reject. --}}
  <input type="hidden" id="supplier-filter" name="filter" value="{{filter}}">
  <input type="hidden" id="supplier-current-page" name="page" value="{{page}}">

  {{#if matchCount}}
  <p class="text-muted small mb-2">Showing {{fromRow}}-{{toRow}} of {{matchCount}}{{#if q}} matching "<strong>{{q}}</strong>"{{/if}}</p>
  <div class="card shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0"
             hx-target="#supplier-results" hx-swap="outerHTML"
             hx-include="#supplier-search, #supplier-filter, #supplier-current-page">
        <thead class="table-light">
          <tr class="small text-uppercase text-nowrap">
            <th class="ps-3">Supplier</th>
            <th>Certificate</th>
            <th class="text-end">Products</th>
            <th>Status</th>
            <th class="pe-3 text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          {{#each suppliers}}
          <tr>
            <td class="ps-3">
              <a href="/sellers/{{user_id}}" class="fw-medium">{{company_name}}</a>
              {{#if location}}<div class="small text-muted">{{location}}</div>{{/if}}
            </td>
            <td class="small">{{#if iso_certification}}{{iso_certification}}{{else}}<span class="text-muted">-</span>{{/if}}</td>
            <td class="text-end">{{product_count}}</td>
            <td class="text-nowrap">
              {{#if isApproved}}<span class="badge rounded-pill badge-verified fw-normal">&#10003; Approved</span>{{/if}}
              {{#if isRejected}}<span class="badge rounded-pill badge-rejected fw-normal">Rejected</span>{{/if}}
              {{#if isWaiting}}<span class="badge rounded-pill badge-waiting fw-normal">Waiting for review</span>{{/if}}
              {{#unless iso_certification}}{{#unless isRejected}}<span class="small text-muted">No certificate</span>{{/unless}}{{/unless}}
            </td>
            <td class="pe-3 text-end text-nowrap">
              {{#if canApprove}}
              <button type="button" class="btn btn-sm btn-dark" hx-put="/admin/suppliers/{{user_id}}" hx-vals='{"status": "Approved"}'>Approve</button>
              {{/if}}
              {{#if isRejected}}
              <button type="button" class="btn btn-sm btn-outline-secondary" hx-put="/admin/suppliers/{{user_id}}" hx-vals='{"status": "Pending"}'
                      hx-confirm="Undo the rejection of {{company_name}}? Their products become visible to buyers again.">Undo reject</button>
              {{else}}
              <button type="button" class="btn btn-sm btn-outline-danger" hx-put="/admin/suppliers/{{user_id}}" hx-vals='{"status": "Rejected"}'
                      hx-confirm="Reject {{company_name}}? Their {{plural product_count "product" "products"}} will be hidden from buyers, and they can no longer add or edit products.">Reject</button>
              {{/if}}
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
  {{> pager pager=pager url="/admin/suppliers/results" target="#supplier-results" include="#supplier-search, #supplier-filter"}}
  {{else}}
  <p class="text-muted">No suppliers here{{#if q}} matching "<strong>{{q}}</strong>"{{/if}}.</p>
  {{/if}}
</div>
{{!-- Fresh numbers for the tabs: only in HTMX answers (the full page has a title and its own tabs). --}}
{{#unless title}}{{> admin-tabs oob=true}}{{/unless}}
