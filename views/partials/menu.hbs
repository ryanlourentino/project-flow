<nav class="navbar navbar-expand site-nav sticky-top">
  <div class="container">
    <a class="navbar-brand d-flex align-items-center gap-2" href="/">
      {{> logo}}
      <span class="brand-name">Project Flow</span>
    </a>
    <ul class="navbar-nav me-auto">
      {{#if user}}
      <li class="nav-item"><a class="nav-link{{#if nav.dashboard}} active{{/if}}" href="/dashboard">Dashboard</a></li>
      <li class="nav-item"><a class="nav-link{{#if nav.categories}} active{{/if}}" href="/categories">Categories</a>
      </li>
      {{#if isAdmin}}
      <li class="nav-item"><a class="nav-link{{#if nav.manage}} active{{/if}}" href="/categories/manage">Manage</a></li>
      {{/if}}
      {{#if isSeller}}
      <li class="nav-item"><a class="nav-link{{#if nav.products}} active{{/if}}" href="/listings">My Products</a></li>
      {{/if}}
      {{#if isBuyer}}
      <li class="nav-item"><a class="nav-link{{#if nav.cart}} active{{/if}}" href="/cart">Cart{{> cart-count}}</a></li>
      {{/if}}
      {{/if}}
    </ul>
    {{#if user}}
    <span class="navbar-text small me-3 d-none d-md-inline">
      {{user.company_name}} <span class="badge rounded-pill text-bg-light border fw-normal">{{user.account_type}}</span>
    </span>
    <form action="/logout" method="POST" class="d-flex">
      <button type="submit" class="btn btn-outline-dark btn-sm">Log out</button>
    </form>
    {{else}}
    <a class="btn btn-dark btn-sm" href="/login">Log in</a>
    {{/if}}
  </div>
</nav>