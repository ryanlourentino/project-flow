<div id="listing-results">
  {{#if resultsError}}<div class="alert alert-danger" role="alert">{{resultsError}}</div>{{/if}}
  {{#if resultsMessage}}<div class="alert alert-success" role="status">{{resultsMessage}}</div>{{/if}}

  {{#if totalCount}}
  {{#if matchCount}}
  <p class="text-muted small mb-2">
    Showing {{fromRow}}-{{toRow}} of {{matchCount}}{{#if q}} matching "<strong>{{q}}</strong>"{{/if}}
    &middot; {{totalCount}} products in total
  </p>
  {{!-- The current page, so Edit / Save / Cancel return to the same page. --}}
  <input type="hidden" id="listing-current-page" name="page" value="{{page}}">

  <div class="card shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0"
             hx-target="#listing-results" hx-swap="outerHTML" hx-include="#listing-search, #listing-current-page">
        <thead class="table-light">
          <tr class="small text-uppercase text-nowrap">
            <th class="ps-3">Item</th>
            <th>Category</th>
            <th class="text-end">{{#if isRental}}Rental price{{else}}Price{{/if}}</th>
            <th class="text-end">Stock</th>
            <th>Terms</th>
            <th class="pe-3 text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          {{#each listings}}
          {{#if editing}}
          <tr class="table-primary">
            <td colspan="6" class="px-3">
              <form hx-put="/listings/{{listing_id}}" class="row g-2 align-items-end py-2">
                <div class="col-12">
                  <span class="fw-medium">{{item_name}}</span>
                  <span class="small text-muted">/ {{unit}} &middot; {{category_name}}{{#if avg_price}} &middot; avg. {{money avg_price}}{{/if}}</span>
                </div>
                <div class="col-md-3">
                  <label for="edit-price" class="form-label small fw-semibold">{{#if @root.isRental}}Rental price{{else}}Price{{/if}} ({{currency}})</label>
                  <input id="edit-price" type="number" name="price" value="{{editPrice}}" min="0.01" step="0.01" required autofocus class="form-control form-control-sm">
                </div>
                <div class="col-md-3">
                  <label for="edit-stock" class="form-label small fw-semibold">Stock</label>
                  <input id="edit-stock" type="number" name="stock" value="{{editStock}}" min="0" max="{{@root.stockMax}}" step="1" required class="form-control form-control-sm">
                </div>
                <div class="col-md-3">
                  <label for="edit-min-order" class="form-label small fw-semibold">Minimum order</label>
                  <input id="edit-min-order" type="number" name="min_order" value="{{editMinOrder}}" min="1" max="{{@root.stockMax}}" step="1" required class="form-control form-control-sm">
                </div>
                <div class="col-md-3">
                  <label for="edit-lead-days" class="form-label small fw-semibold">Lead time (days)</label>
                  <input id="edit-lead-days" type="number" name="lead_days" value="{{editLeadDays}}" min="0" max="{{@root.leadMax}}" step="1" required class="form-control form-control-sm">
                </div>
                <div class="col-12">
                  <label for="edit-description" class="form-label small fw-semibold">Description <span class="text-muted">(optional)</span></label>
                  <textarea id="edit-description" name="description" rows="2" maxlength="{{@root.descMax}}" class="form-control form-control-sm">{{editDescription}}</textarea>
                </div>
                <div class="col-12">
                  <button type="submit" class="btn btn-sm btn-primary">Save</button>
                  <button type="button" class="btn btn-sm btn-outline-secondary" hx-get="/listings/results">Cancel</button>
                </div>
              </form>
            </td>
          </tr>
          {{else}}
          <tr>
            <td class="ps-3">
              <div class="fw-medium">{{item_name}}{{#unless is_reviewed}} <span class="badge rounded-pill badge-new fw-normal" title="Waiting for the Admin's review">New</span>{{/unless}}</div>
              {{#if description}}
              <details class="small text-muted mt-1">
                <summary>Description</summary>
                <div class="text-break" style="white-space: pre-line;">{{description}}</div>
              </details>
              {{/if}}
            </td>
            <td><span class="badge rounded-pill text-bg-light border fw-normal">{{category_name}}</span></td>
            <td class="text-end text-nowrap">
              <div><span class="fw-semibold">{{money price}}</span> <span class="small text-muted">/ {{unit}}</span></div>
              {{#if avg_price}}<div class="small text-muted">avg. {{money avg_price}}</div>{{/if}}
            </td>
            <td class="text-end">
              {{#if stock}}{{stock}}{{else}}<span class="badge text-bg-danger">Sold out</span>{{/if}}
            </td>
            <td class="small text-nowrap">
              <div>Min. order {{min_order}}</div>
              <div class="text-muted">{{#if lead_days}}{{plural lead_days "day" "days"}} lead time{{else}}Same-day delivery{{/if}}</div>
            </td>
            <td class="pe-3 text-end text-nowrap">
              <button type="button" class="btn btn-sm btn-outline-secondary" hx-get="/listings/{{listing_id}}/edit">Edit</button>
              <button type="button" class="btn btn-sm btn-outline-danger"
                      hx-delete="/listings/{{listing_id}}" hx-target="#listing-page"
                      hx-confirm="Delete your listing for {{item_name}}?">Delete</button>
            </td>
          </tr>
          {{/if}}
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>

  {{#if pager}}
  <nav aria-label="Listing pages" class="mt-3">
    <ul class="pagination justify-content-center"
        hx-target="#listing-results" hx-swap="outerHTML" hx-include="#listing-search">
      <li class="page-item {{#if pager.atStart}}disabled{{/if}}">
        <button type="button" class="page-link" aria-label="First page" {{#if pager.atStart}}disabled{{/if}}
                hx-get="/listings/results" hx-vals='{"page": {{pager.first}} }'>&laquo;</button>
      </li>
      <li class="page-item {{#if pager.atStart}}disabled{{/if}}">
        <button type="button" class="page-link" aria-label="Previous page" {{#if pager.atStart}}disabled{{/if}}
                hx-get="/listings/results" hx-vals='{"page": {{pager.prev}} }'>&lsaquo;</button>
      </li>
      {{#each pager.numbers}}
      <li class="page-item {{#if current}}active{{/if}}" {{#if current}}aria-current="page"{{/if}}>
        <button type="button" class="page-link"
                hx-get="/listings/results" hx-vals='{"page": {{number}} }'>{{number}}</button>
      </li>
      {{/each}}
      <li class="page-item {{#if pager.atEnd}}disabled{{/if}}">
        <button type="button" class="page-link" aria-label="Next page" {{#if pager.atEnd}}disabled{{/if}}
                hx-get="/listings/results" hx-vals='{"page": {{pager.next}} }'>&rsaquo;</button>
      </li>
      <li class="page-item {{#if pager.atEnd}}disabled{{/if}}">
        <button type="button" class="page-link" aria-label="Last page" {{#if pager.atEnd}}disabled{{/if}}
                hx-get="/listings/results" hx-vals='{"page": {{pager.last}} }'>&raquo;</button>
      </li>
    </ul>
  </nav>
  {{/if}}
  {{else}}
  <p class="text-muted">No products match "<strong>{{q}}</strong>".</p>
  {{/if}}
  {{else}}
  <p class="text-muted">You have no products yet. Add your first one above.</p>
  {{/if}}
</div>
