<div id="listing-results">
    {{#if totalCount}}
    {{#if matchCount}}
    <p class="text-muted small mb-2">
        Showing {{fromRow}}-{{toRow}} of {{matchCount}}{{#if q}} matching "<strong>{{q}}</strong>"{{/if}}
        &middot; {{totalCount}} listings in total
    </p>
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr class="small text-uppercase text-nowrap">
                        <th class="ps-3">Item</th>
                        <th>Category</th>
                        <th class="text-end">{{#if isRental}}Price / day{{else}}Price{{/if}}</th>
                        <th class="text-end">Stock</th>
                        <th class="pe-3">Terms</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each listings}}
                    <tr>
                        <td class="ps-3">
                            <div class="fw-medium">{{item_name}}</div>
                            <div class="small text-muted">per {{unit}}</div>
                            {{#if description}}
                            <details class="small text-muted mt-1">
                                <summary>Description</summary>
                                <div class="text-break" style="white-space: pre-line;">{{description}}</div>
                            </details>
                            {{/if}}
                        </td>
                        <td><span class="badge rounded-pill text-bg-light border fw-normal">{{category_name}}</span>
                        </td>
                        <td class="text-end text-nowrap">
                            <div class="fw-semibold">{{price}}</div>
                            <div class="small text-muted">avg. {{avg_price}}</div>
                        </td>
                        <td class="text-end">
                            {{#if stock}}{{stock}}{{else}}<span class="badge text-bg-danger">Sold out</span>{{/if}}
                        </td>
                        <td class="pe-3 small text-nowrap">
                            <div>Min. order {{min_order}}</div>
                            <div class="text-muted">{{#if lead_days}}{{lead_days}} days lead time{{else}}Same-day
                                delivery{{/if}}</div>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>

    {{#if pager}}
    <nav aria-label="Listing pages" class="mt-3">
        <ul class="pagination justify-content-center" hx-target="#listing-results" hx-swap="outerHTML"
            hx-include="#listing-search">
            <li class="page-item {{#if pager.atStart}}disabled{{/if}}">
                <button type="button" class="page-link" aria-label="First page" {{#if pager.atStart}}disabled{{/if}}
                    hx-get="/listings/results" hx-vals='{"page": {{pager.first}} }'>&laquo;</button>
            </li>
            <li class="page-item {{#if pager.atStart}}disabled{{/if}}">
                <button type="button" class="page-link" aria-label="Previous page" {{#if pager.atStart}}disabled{{/if}}
                    hx-get="/listings/results" hx-vals='{"page": {{pager.prev}} }'>&lsaquo;</button>
            </li>
            {{#each pager.numbers}}
            <li class="page-item {{#if current}}active{{/if}}" {{#if current}}aria-current="page" {{/if}}>
                <button type="button" class="page-link" hx-get="/listings/results"
                    hx-vals='{"page": {{number}} }'>{{number}}</button>
            </li>
            {{/each}}
            <li class="page-item {{#if pager.atEnd}}disabled{{/if}}">
                <button type="button" class="page-link" aria-label="Next page" {{#if pager.atEnd}}disabled{{/if}}
                    hx-get="/listings/results" hx-vals='{"page": {{pager.next}} }'>&rsaquo;</button>
            </li>
            <li class="page-item {{#if pager.atEnd}}disabled{{/if}}">
                <button type="button" class="page-link" aria-label="Last page" {{#if pager.atEnd}}disabled{{/if}}
                    hx-get="/listings/results" hx-vals='{"page": {{pager.last}} }'>&raquo;</button>
            </li>
        </ul>
    </nav>
    {{/if}}
    {{else}}
    <p class="text-muted">No listings match "<strong>{{q}}</strong>".</p>
    {{/if}}
    {{else}}
    <p class="text-muted">You have no listings yet. Add your first one above.</p>
    {{/if}}
</div>