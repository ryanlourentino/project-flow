# Copy this file to .env and change the values. Never commit .env.
# These values are used by docker-compose.yml AND by config.js.

# MySQL container
DB_ROOT_PASSWORD=rootpassword
DB_NAME=projectflow
DB_USER=expressApp
DB_PASSWORD=expressPassword

# App
# Inside Docker the database host is the compose service name "db" (not an IP address).
# If you run "npm start" on your own machine instead, use DB_HOST=127.0.0.1 and DB_PORT=3307.
DB_HOST=db
DB_PORT=3306
COOKIE_SECRET=change-this-secret
APP_PORT=3000
